{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':dependencyDashboard',
  ],
  baseBranchPatterns: [
    'main',
  ],
  packageRules: [
    {
      matchPackageNames: [
        '*',
      ],
      schedule: [
        'on monday',
      ],
      automerge: true,
    },
  ],
  ansible: {
    managerFilePatterns: [
      '/.*\\.ya?ml$/',
      '/roles/.*/tasks/.*\\.ya?ml$/',
      '/ansible/.*/.*\\.ya?ml$/',
    ],
  },
  separateMajorMinor: true,
}
